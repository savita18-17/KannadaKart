# GEMINI_API_KEY: Optional for future live Gemini AI integration.
# The application runs completely in Demo Mode without requiring API keys.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Future Supabase Integration (Optional - Demo Mode works without these)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_ENABLE_DEMO_MODE="true"
